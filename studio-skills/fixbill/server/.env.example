# Server Configuration
PORT=4000
NODE_ENV=production

# Security & CORS
# FRONTEND_URL should be your live Vercel domain (e.g., https://fixbill.vercel.app)
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Assets
# Relative to the server directory
THAI_FONT_PATH=./assets/fonts/NotoSansThai-Regular.ttf
